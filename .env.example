# ============================================================
#  Réception à quai NEOTRADE — variables d'environnement
#  Copier ce fichier en .env puis compléter les valeurs.
# ============================================================

# --- Base PostgreSQL ---
# Sur Vercel : remplies automatiquement par l'intégration Supabase (Vercel → Storage → Supabase).
# Local : postgresql://reception:reception@localhost:5432/reception (les deux URL identiques)
POSTGRES_PRISMA_URL="postgresql://reception:reception@localhost:5432/reception"
POSTGRES_URL_NON_POOLING="postgresql://reception:reception@localhost:5432/reception"

# --- Auth.js ---
# Générer avec : openssl rand -base64 32
# Sur Vercel avec l'intégration Supabase : facultatif (SUPABASE_JWT_SECRET est utilisé à défaut)
AUTH_SECRET="TODO-generer-une-cle-secrete"

# --- Comptes créés par le seed (npm run db:seed) ---
SEED_MANAGER_NAME="Responsable"
SEED_MANAGER_PIN="TODO-4-a-6-chiffres"
SEED_CARISTE_PIN="1357"
# "false" pour ne pas créer les deux réceptions d'exemple (à mettre en production)
SEED_EXAMPLE="true"

# --- Lecture automatique de la CMR (photo → réception pré-remplie) ---
# Clé API Anthropic (console.anthropic.com → API Keys). Sans clé : saisie manuelle uniquement.
ANTHROPIC_API_KEY=""
# "true" pour tester sans clé : toute photo est lue comme l'exemple réel 80977/652747
CMR_EXTRACTION_MOCK="false"

# --- Stockage des photos ---
# Production : Supabase Storage (fournies par l'intégration Supabase ; le bucket privé est créé au premier envoi).
# Sans ces valeurs : dossier local ./uploads
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="reception"

# --- Premier démarrage ---
# Code demandé pour créer le premier responsable depuis le téléphone (page /premier-demarrage),
# utilisable uniquement tant qu'aucun compte n'existe. Choisissez un mot difficile à deviner.
SETUP_CODE="TODO-code-installation"
