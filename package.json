{
  "name": "neotrade-reception",
  "version": "0.1.0",
  "private": true,
  "description": "Contrôle à quai des camions Kuehne+Nagel — NEOTRADE / SAS KASMI (Douvrin)",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && node scripts/copy-wasm.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@prisma/client": "6.19.3",
    "barcode-detector": "3.2.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "3.2.4"
  }
}
